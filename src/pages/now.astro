---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `Now — ${SITE.name}`,
  url: new URL('/now/', SITE.url).toString(),
  description: 'What I\'m doing right now. Inspired by nownownow.com.',
};
---

<BaseLayout
  title="Now"
  description="What I'm doing right now. Inspired by nownownow.com."
  jsonLd={jsonLd}
>
  <main class="container">
    <div class="page-title">
      <h1>Now</h1>
      <p>What I'm focused on right now.</p>
      <p class="now-updated">
        Last updated: <time datetime="2026-07-17">July 17, 2026</time>
      </p>
    </div>

    <div class="prose" style="padding-top:24px">
      <h2>Right now</h2>
      <p>
        Two things get most of my energy: reviewing plugin submissions on
        WordPress.org with the Plugins Team, and building Heya.
      </p>

      <h2>Building</h2>
      <ul>
        <li>
          <a
            href="https://github.com/shameemreza/heya"
            target="_blank"
            rel="noopener noreferrer">Heya</a>, my local-first AI agent for
          WordPress and WooCommerce support engineers. Shipping releases on PyPI
          and growing the diagnostic pipeline.
        </li>
        <li>
          This site. A slow polish pass: new heading font, honest read times,
          cleaner typography. One change at a time.
        </li>
      </ul>

      <h2>Learning</h2>
      <ul>
        <li>
          Block theme development. Larder and Kairo taught me the basics; now I'm
          going deeper into patterns, style variations, and theme.json.
        </li>
        <li>
          Leadership. I went through Automattic's Emerging Leaders program and I'm
          practicing it daily: problem framing, honest feedback, owning what's mine.
        </li>
      </ul>

      <h2>Health</h2>
      <p>
        I've been getting sick more often than I'd like, so taking care of myself
        is on the list now. Better sleep, more movement, fewer late nights at
        the desk.
      </p>
    </div>

    <div class="prose" style="padding-top:32px">
      <hr />
      <p>
        This page is inspired by <a
          href="https://nownownow.com/about"
          target="_blank"
          rel="noopener noreferrer">nownownow.com</a
        >.
      </p>
    </div>
  </main>
</BaseLayout>
