---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, AUTHOR } from '../config';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Larder',
  applicationCategory: 'WordPress Theme',
  operatingSystem: 'WordPress 6.7+',
  url: new URL('/larder/', SITE.url).toString(),
  author: {
    '@type': 'Person',
    name: AUTHOR.name,
    url: SITE.url,
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<BaseLayout
  title="Larder"
  description="Larder is a warm WordPress block theme built for food shops, farm stores, and organic markets. WooCommerce ready, Full Site Editing, local fonts, GDPR compliant. Free on WordPress.org."
  jsonLd={jsonLd}
>
  <main class="container">
    <div class="page-title">
      <h1>Larder</h1>
      <p>A warm WordPress block theme for food shops, farm stores, and organic markets.</p>
    </div>

    <div class="theme-actions">
      <a href="https://wordpress.org/themes/larder/" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
        Download on WordPress.org
      </a>
      <a href="https://larder.shameem.dev/" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
        Live demo
      </a>
    </div>

    <div class="prose" style="padding-top:24px">

      <h2>Why Larder</h2>
      <p>
        Most WooCommerce themes try to do everything. Larder doesn't. It's built for one thing:
        stores that sell fresh goods. Grocery shops, farmers markets, organic food stores, anything
        where the product photography matters and the layout should get out of the way.
      </p>
      <p>
        The homepage comes ready with a hero banner, product category cards, featured products, sale
        items, and new arrivals. All editable through the Site Editor, no code needed. If you don't
        run a shop, Larder works fine as a blog or content site too.
      </p>
      <p>
        Larder is free, open source, and hosted on
        <a href="https://wordpress.org/themes/larder/" target="_blank" rel="noopener noreferrer">WordPress.org</a>.
      </p>

      <h2>Screenshots</h2>

      <div class="theme-screenshots">
        <figure class="theme-screenshot">
          <img src="/images/larder/larder-preview.gif" alt="Larder theme full preview" loading="lazy" />
          <figcaption>Full Preview</figcaption>
        </figure>

        <figure class="theme-screenshot theme-screenshot--wide">
          <img src="/images/larder/larder-1.png" alt="Larder theme hero section" loading="lazy" />
          <figcaption>Hero Section</figcaption>
        </figure>

        <figure class="theme-screenshot">
          <img src="/images/larder/larder-2.png" alt="Larder theme featured products section" loading="lazy" />
          <figcaption>Featured Products Section</figcaption>
        </figure>

        <figure class="theme-screenshot">
          <img src="/images/larder/larder-3.png" alt="Larder theme footer section" loading="lazy" />
          <figcaption>Footer</figcaption>
        </figure>

        <figure class="theme-screenshot">
          <img src="/images/larder/larder-6.png" alt="Larder theme blog archive page" loading="lazy" />
          <figcaption>Blog</figcaption>
        </figure>

        <figure class="theme-screenshot">
          <img src="/images/larder/larder-4.png" alt="Larder theme single product page" loading="lazy" />
          <figcaption>Single product</figcaption>
        </figure>

        <figure class="theme-screenshot">
          <img src="/images/larder/larder-5.png" alt="Larder theme shop archive page" loading="lazy" />
          <figcaption>Shop Archive</figcaption>
        </figure>
      </div>

      <h2>Features</h2>
      <ul>
        <li><strong>Full Site Editing:</strong> customizable templates, template parts, and block patterns.</li>
        <li><strong>WooCommerce ready:</strong> Product Collection, Cart, Checkout, and Mini Cart work out of the box.</li>
        <li><strong>Local fonts:</strong> Lora and Source Sans 3, self-hosted for GDPR compliance and faster loads.</li>
        <li><strong>Warm color palette:</strong> designed around food, grocery, and organic store branding.</li>
        <li><strong>Two style variations:</strong> Earth Tones and Forest Green for quick redesigns.</li>
        <li><strong>Homepage patterns:</strong> hero, categories, featured products, on sale, new arrivals, call to action.</li>
        <li><strong>Mobile friendly:</strong> slide-in menu and full-screen search overlay.</li>
        <li><strong>Accessible:</strong> visible focus states, screen reader text, and reduced motion support.</li>
        <li><strong>Translation ready:</strong> fully translatable with proper text domains.</li>
      </ul>

      <h2>Block patterns</h2>
      <p>
        Larder ships with homepage patterns so you can build a storefront without touching code.
      </p>
      <ul>
        <li><strong>Hero:</strong> full-width cover image with centered text overlay and CTA buttons.</li>
        <li><strong>Product categories:</strong> gradient overlay cards with hover description reveal.</li>
        <li><strong>Featured products:</strong> hand-picked product grid.</li>
        <li><strong>On sale products:</strong> highlighted sale items.</li>
        <li><strong>New arrivals:</strong> latest products grid.</li>
        <li><strong>Call to action:</strong> banner section with heading and button.</li>
      </ul>

      <h2>Style variations</h2>
      <ul>
        <li><strong>Default:</strong> warm cream background with orange and gold accents.</li>
        <li><strong>Earth Tones:</strong> muted brown palette with sage accents.</li>
        <li><strong>Forest Green:</strong> deep green palette with warm highlights.</li>
      </ul>

      <h2>Requirements</h2>
      <ul>
        <li>WordPress 6.7 or higher.</li>
        <li>PHP 8.0 or higher.</li>
        <li>WooCommerce (optional, only needed for shop features).</li>
      </ul>

      <h2>Support</h2>
      <p>
        Larder is free and open source. For questions or bug reports, visit the
        <a href="https://wordpress.org/support/theme/larder/" target="_blank" rel="noopener noreferrer">WordPress.org support forum</a>.
        You can also open an issue on
        <a href="https://github.com/shameemreza/larder" target="_blank" rel="noopener noreferrer">GitHub</a>.
      </p>
      <p>
        If you like Larder, a
        <a href="https://wordpress.org/support/theme/larder/reviews/#new-post" target="_blank" rel="noopener noreferrer">review on WordPress.org</a>
        helps others find it.
      </p>

    </div>
  </main>
</BaseLayout>
