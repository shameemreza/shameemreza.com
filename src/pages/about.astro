---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  SITE,
  AUTHOR,
  EXPERIENCE,
  SKILLS,
  DOMAINS,
  SOCIAL_LINKS,
} from '../config';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `About — ${SITE.name}`,
  url: new URL('/about/', SITE.url).toString(),
  mainEntity: {
    '@type': 'Person',
    name: AUTHOR.name,
    jobTitle: 'Happiness Engineer',
    worksFor: { '@type': 'Organization', name: 'Automattic' },
    url: SITE.url,
    sameAs: SOCIAL_LINKS.map((l) => l.href),
    knowsAbout: [...SKILLS],
  },
};
---

<BaseLayout
  title="About"
  description={`About ${AUTHOR.name}. Happiness Engineer at Automattic and member of the WordPress.org Plugins Team. Supporting WooCommerce merchants, reviewing plugin submissions, and building plugins and themes.`}
  jsonLd={jsonLd}
>
  <main class="container">
    <div class="about-header">
      <div class="about-avatar">
        <img
          src={AUTHOR.avatar}
          alt={`Photo of ${AUTHOR.name}`}
          width="72"
          height="72"
          loading="eager"
        />
      </div>
      <div class="about-header-text">
        <h1>{AUTHOR.name}</h1>
        <p>Happiness Engineer at Automattic. Member of the WordPress.org Plugins Team. Plugin builder. Writer.</p>
      </div>
    </div>

    <div class="about-body">
      <div class="prose">
        <p>
          I'm a Happiness Engineer at <a
            href="https://automattic.com"
            target="_blank"
            rel="noopener noreferrer">Automattic</a
          >, the company behind WordPress.com, WooCommerce, Jetpack, and Tumblr.
          I spend my days inside broken checkouts, failing subscription renewals,
          and plugin code that almost works. I like it there.
        </p>

        <h2>What I do at Automattic</h2>
        <p>
          I handle the complex technical cases that need both deep product knowledge
          and hands-on coding skills. Subscription renewals failing silently, payment
          gateways that stop processing mid-launch, checkout pages breaking after a
          routine update. I work across <a
            href="https://woocommerce.com"
            target="_blank"
            rel="noopener noreferrer">WooCommerce</a
          > Subscriptions, Bookings, Memberships, AutomateWoo, Product Bundles,
          WooPayments, Stripe, PayPal, and more.
        </p>
        <p>
          I also review plugin submissions to WooCommerce.com for code quality,
          security, and UX, and I carry what merchants tell me in tickets back to
          the product teams.
        </p>

        <h2>How I approach support</h2>
        <p>
          Four years of support taught me a way of working that goes beyond tickets.
          Investigate before answering. Trace every claim to something real: the logs,
          the plugin's code, an official doc. Write the reply so it doesn't need
          a second read.
        </p>
        <p>
          I also went through Automattic's Emerging Leaders program, which changed
          how I frame problems and give feedback. The short version: own what's yours
          before asking who dropped it, and spend most of your time understanding the
          problem instead of defending a solution.
        </p>

        <h2>What I build</h2>
        <p>
          The problems I see in support often become the products I
          build. <a
            href="https://github.com/shameemreza/happyaccess"
            target="_blank"
            rel="noopener noreferrer">HappyAccess</a> handles temporary admin access
          with OTP and magic links, so nobody has to share a real
          password. <a
            href="https://github.com/shameemreza/snipdrop"
            target="_blank"
            rel="noopener noreferrer">SnipDrop</a> is the WooCommerce code snippets
          I kept rewriting for merchants, tested and one-click
          installable. <a
            href="https://github.com/shameemreza/assistify-for-woocommerce"
            target="_blank"
            rel="noopener noreferrer">Assistify for WooCommerce</a> adds small tools
          for store owners. On the theme side there's <a
            href="/larder/">Larder</a>, a warm block theme for food shops and farm
          stores, and <a
            href="/kairo/">Kairo</a>, a clean one for personal blogs and portfolios.
          Everything lives on WordPress.org and GitHub.
        </p>
        <p>
          The biggest build so far is the one I couldn't find anywhere else: an AI
          agent made for support work.
        </p>

        <h2>How I use AI</h2>
        <p>
          AI didn't replace the way I work. It moved in with me. My setup is a
          personal system I call dotbrain: 60+ custom skills for Claude Code and
          Cursor that carry my writing voice, my plugin review checklists, and my
          debugging habits from one machine to the next. The AI sounds like me
          because I taught it to.
        </p>
        <p>
          <a
            href="https://github.com/shameemreza/heya"
            target="_blank"
            rel="noopener noreferrer">Heya</a> is where that thinking became a
          product. It's a local-first terminal agent for WordPress and WooCommerce
          support engineers. You hand it a bug report, it reproduces the issue on a
          disposable test site, finds the cause, and hands back evidence you can
          check yourself. It runs on any model, including small ones that never
          leave your machine.
        </p>
        <p>
          And when the tooling breaks on me, that becomes a blog post.
        </p>

        <h2>WordPress.org contributions</h2>
        <p>
          I'm a member of the <a
            href="https://make.wordpress.org/plugins/handbook/the-team/"
            target="_blank"
            rel="noopener noreferrer">WordPress.org Plugins Team</a
          >, where I review plugin submissions on WordPress.org for code quality,
          security, and guideline compliance. I also provide support in the plugin
          forums for WooCommerce (7M+ active installs), WooPayments, Stripe, PayPal
          Payments, Google for WooCommerce, and more. Beyond that, I'm active as a
          plugin developer, theme author, pattern author, and translation contributor.
        </p>

        <h2>What drives me</h2>
        <p>
          Before Automattic I freelanced for ten years through <a
            href="https://www.upwork.com/freelancers/shameemreza"
            target="_blank"
            rel="noopener noreferrer">Upwork</a> and Elance. 60+ projects across
          North America, Europe, the Middle East, and Asia, Top Rated with a 100%
          Job Success score. More than the projects, those years taught me what a
          broken store costs the person who owns it. Rent money, staff wages,
          sleep. That never left me. So:
        </p>
        <ul>
          <li>A fix the merchant can apply in five minutes beats a clever one they can't. Most store owners don't have a developer on call.</li>
          <li>Most “impossible” bugs are three ordinary bugs stacked on top of each other. Patience finds them one at a time.</li>
          <li>If a reply needs a second read, it isn't finished. Clear writing is part of the fix.</li>
        </ul>
        <p>
          Support is more than troubleshooting. It's making technology work for
          people who have a store to run.
        </p>

        <h2>Beyond work</h2>
        <p>
          I'm a father and husband from Khulna, Bangladesh, grateful for a family that
          keeps me grounded. I graduated with a BSc in Computer Science and hold a
          Postgraduate Certificate in Project Management. When I'm not debugging,
          I'm probably exploring a new city, learning a new language, or overthinking
          my next side project.
        </p>
      </div>
    </div>

    <div class="section-divider">
      <h2 class="section-label">Experience</h2>
    </div>
    <div class="card-group">
      {
        EXPERIENCE.map((exp) => (
          <a
            href={exp.url}
            target="_blank"
            rel="noopener noreferrer"
            class="hover-card exp-item"
          >
            <div class="card-bg" />
            <div class="exp-period">{exp.period}</div>
            <div>
              <h3 class="exp-title">
                {exp.title} · {exp.company}{' '}
                <span class="arrow">↗</span>
              </h3>
              <p class="exp-desc">{exp.description}</p>
              <div class="tech-tags">
                {exp.tech.map((t) => (
                  <span class="tech-tag">{t}</span>
                ))}
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <section class="skills-section">
      <h2>Tools & technologies</h2>
      <div class="skills-grid">
        {SKILLS.map((skill) => <span class="skill-pill">{skill}</span>)}
      </div>
    </section>

    <section class="domains-section">
      <h2>My domains</h2>
      {
        DOMAINS.map((d) => (
          <div class="domain-item">
            <span class="d-old">{d.old}</span>
            <span class="d-arrow">→</span>
            <span class="d-new">{d.new}</span>
            <span class="d-label">301</span>
          </div>
        ))
      }
    </section>

    <div style="padding-top:32px">
      <div class="social-row">
        {
          SOCIAL_LINKS.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label} ↗
            </a>
          ))
        }
      </div>
    </div>
  </main>
</BaseLayout>
